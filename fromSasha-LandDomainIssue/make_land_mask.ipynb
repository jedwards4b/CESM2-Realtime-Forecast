 'interpolated crujra mask onto JRA55 domain (in order to mimic TRENDY mask where oceans and Antarctica are masked)'\\n\",","    \"ds.to_netcdf(\\\"/glade/u/home/sglanvil/analysis/python/analysis/domain.JRA55_crujra.0.56x0.56.c240501.nc\\\")\\n\",","    \"# ds.to_netcdf(\\\"/glade/u/home/sglanvil/analysis/python/analysis/domain.JRA55.0.56x0.56.c240430.nc\\\") # original file name\\n\",","    \"\\n\",","    \"# ------------- plot old mask and new  mask -------------\\n\",","    \"fig, axs = plt.subplots(1, 2, figsize=(8, 3)) \\n\",","    \"cmap = 'viridis'  # Example colormap\\n\",","    \"im0 = axs[0].contourf(old_mask,cmap=cmap)\\n\",","    \"axs[0].set_title('old mask')\\n\",","    \"im1 = axs[1].contourf(mask,cmap=cmap)\\n\",","    \"axs[1].set_title('new mask')\\n\",","    \"cbar = fig.colorbar(im1, ax=axs, orientation='horizontal',\\n\",","    \"                    pad=0.15, fraction=0.05, aspect=60)\\n\",","    \"cbar.set_label('mask')\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 13,","   \"id\": \"5c481695-dfd4-41c3-89c0-0909e3bcd3ed\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"\u003cxarray.DataArray 'area' ()\u003e\\n\",","      \"array(0.)\\n\",","      \"\u003cxarray.DataArray 'area' ()\u003e\\n\",","      \"array(0.)\\n\"","     ]","    },","    {","     \"data\": {","      \"image/png\": \"\",","      \"text/plain\": [","       \"\u003cFigure size 800x300 with 4 Axes\u003e\"","      ]","     },","     \"metadata\": {},","     \"output_type\": \"display_data\"","    }","   ],","   \"source\": [","    \"import xarray as xr\\n\",","    \"import numpy as np\\n\",","    \"import matplotlib.pyplot as plt\\n\",","    \"from scipy.interpolate import RectBivariateSpline\\n\",","    \"import datetime\\n\",","    \"\\n\",","    \"file1 = \\\"/glade/campaign/cesm/development/espwg/SMYLE/initial_conditions/land_forcing/three_stream/d